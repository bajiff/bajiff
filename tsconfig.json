{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "module": "ES2020",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "astro/client"
    ],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "src/**/*",
    "astro.config.ts"
  ]
}